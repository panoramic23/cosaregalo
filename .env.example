# Impostare le credenziali nel pannello SiteGround, non pubblicarle su GitHub
PORT=3000
NODE_ENV=production
AMAZON_CREATORS_CLIENT_ID=
AMAZON_CREATORS_CLIENT_SECRET=
AMAZON_CREATORS_VERSION=3.2
AMAZON_PARTNER_TAG=
KV_REST_API_URL=
KV_REST_API_TOKEN=
ADMIN_DASHBOARD_TOKEN=

# Profili social: link HTTPS completi; icone visibili ma non cliccabili se vuoti.
SOCIAL_INSTAGRAM_URL=
SOCIAL_TIKTOK_URL=
SOCIAL_PINTEREST_URL=

# Pubblicita: off | adsense | cj. Off fino al consenso e alla configurazione.
ADS_MODE=off

# Google AdSense: client pubblico e slot pubblici, non sono chiavi segrete.
ADSENSE_CLIENT=
ADSENSE_SLOT_HOME_TOP=
ADSENSE_SLOT_HOME_MIDDLE=
ADSENSE_SLOT_ARTICLE_INLINE=
ADSENSE_SLOT_SITE_BOTTOM=

# Commission Junction: URL banner e URL di tracciamento ottenuti da CJ.
# Inserire solo HTTPS e materiali pubblicitari autorizzati dal programma.
CJ_BANNER_LINK=
CJ_BANNER_IMAGE=
CJ_BANNER_ALT=

# Indicizzazione: lascia false finche il dominio ufficiale non e' online e testato.
SITE_INDEXABLE=false
SITE_PUBLIC_URL=https://cosa-regalo.it

# CMP CERTIFICATA GOOGLE: attivare SOLO dopo aver pubblicato il messaggio
# "Regolamenti europei" in AdSense > Privacy e messaggi, sul medesimo sito.
# Per default resta attivo il banner personalizzato e nessun tag Google CMP.
CMP_PROVIDER=custom
GOOGLE_CMP_PUBLISHED=false
# Con CMP_PROVIDER=google e GOOGLE_CMP_PUBLISHED=true e ADSENSE_CLIENT valido,
# il server include il tag AdSense necessario a Google Privacy & Messaging.
# ADS_MODE=off mantiene gli slot pubblicitari del sito disattivati.

